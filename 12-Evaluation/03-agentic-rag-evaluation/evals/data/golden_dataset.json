{
  "dataset_name": "company_knowledge_base_golden_dataset",
  "description": "A gold-standard evaluation set for testing retrieval, answer quality, and tool selection against the company datasets and the chatbot's tool",
  "cases": [
    {
      "id": "accounts_north_america",
      "category": "crm",
      "query": "which accounts are active in North America",
      "expected_answer": "HeathFirst, RetailMax, FinTrust, and TechNova are active accounts in North America.",
      "expected_keywords": [
        "HeathFirst",
        "RetailMax",
        "FinTrust",
        "TechNova",
        "North America"
      ],
      "expected_tool": "search_knowledge_base",
      "expected_sources": [
        "crm_exports/accounts.csv"
      ]
    },
    {
      "id": "healthfirst_opportunity_status",
      "category": "crm",
      "query": "What was the status of the HealthFirst AWS Migration opportunity and what was its deal value?",
      "expected_answer": "The HealthFirst AWS Migration opportunity was lost in the Negotiation stage with a deal value of $500,000.",
      "expected_keywords": [
        "HealthFirst",
        "AWS Migration",
        "Lost",
        "Negotiation",
        "500000"
      ],
      "expected_tool": "search_knowledge_base",
      "expected_sources": [
        "crm_exports/opportunities.csv"
      ]
    },
    {
      "id": "snowflake_sales_rep",
      "category": "crm",
