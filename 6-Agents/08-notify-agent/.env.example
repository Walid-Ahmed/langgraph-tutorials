# Copy these lines into the repo-root .env and fill them in.
OPENAI_API_KEY=sk-...

# Telegram (see tools/telegram.py for how to get both values)
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=123456789

# Gmail (use an App Password, never your normal password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Discord (channel settings -> Integrations -> Webhooks -> copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: who the agent may email (comma-separated). Default: GMAIL_ADDRESS only.
# ALLOWED_EMAIL_RECIPIENTS=you@gmail.com

# Optional: set to 1 to print messages instead of sending them.
# NOTIFY_DRY_RUN=1
